# ID сервера на gamearmy.ru (например, 209558)
GAMEARMY_SERVER_ID=209558

# Telegram Bot (оставить пустыми для работы без отправки в Telegram)
TELEGRAM_BOT_TOKEN=
CHAT_ID=
# Адрес Telegram Bot API (для зеркала/local Bot API server). По умолчанию https://api.telegram.org
TELEGRAM_API_URL=

# База данных SQLite
DB_FILE_PATH=server_players.db

# Название сервера для отображения в сообщениях
SERVER_NAME=West UT3
